{
    "manifest_version":3,
    "name":"BuildMyCareer",
    "description": "Smart autofill assistant for job applications",
    "version": "1.0",
    "permissions": ["storage", "activeTab", "Scripting"],
    "options_page": "web/options/options.html",
    "action":{
        "default_popup": "web/popup/popup.html"
    },
    "content_scripts": [{
        "matches": ["<all_urls>"],
        "js": ["profile.js","content.js"]
    }]
}