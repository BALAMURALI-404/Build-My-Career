{
    "manifest_version":3,
    "name":"BuildMyCareer",
    "description": "Smart autofill assistant for job applications",
    "version": "1.0",
    "permissions": ["storage", "activeTab", "Scripting"],
    "content_scripts": [{
        "matches": ["<all_urls>"],
        "js": ["profile.js","content.js"]
    }]
}